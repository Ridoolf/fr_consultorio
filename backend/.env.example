# Copiá este archivo a .env (solo en tu PC):
#   copy .env.example .env
#
# .env NUNCA se sube a GitHub. En Render las variables van en el panel del servicio.

# === Desarrollo local (recomendado) ===
USE_LOCAL_DB=true
DEBUG=true
SECRET_KEY=django-local-dev-only-change-me
CONSULTORIO_USER=consultorio
CONSULTORIO_PASSWORD=tu_password_local
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_ZONE=America/Argentina/Buenos_Aires

# === Postgres local (opcional) ===
# USE_LOCAL_DB=false
# DATABASE_URL=postgresql://usuario:password@127.0.0.1:5432/consultorio

# === Producción (Render) — NO uses .env del repo ===
# SECRET_KEY=...
# DEBUG=false
# DATABASE_URL=... (auto desde Postgres de Render)
# ALLOWED_HOSTS=fr-consultorio-backend.onrender.com
# CORS_ALLOWED_ORIGINS=https://fr-consultorio.netlify.app
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
# CONSULTORIO_USER=consultorio
# CONSULTORIO_PASSWORD=...
